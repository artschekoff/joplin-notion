{
  "name": "net.roxl.joplin-notion",
  "version": "0.0.1",
  "scripts": {
    "dist": "webpack --env joplin-plugin-config=buildMain && webpack --env joplin-plugin-config=buildExtraScripts && webpack --env joplin-plugin-config=createArchive",
    "prepare": "husky && npm run dist",
    "postinstall": "npm audit --audit-level=moderate || true",
    "updateVersion": "webpack --env joplin-plugin-config=updateVersion",
    "dev": "webpack --watch --progress --stats normal --env joplin-plugin-config=buildMain",
    "test": "jest",
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "format:check": "prettier --check 'src/**/*.ts'",
    "format": "prettier --write 'src/**/*.ts'",
    "security:audit:prod": "snyk test --severity-threshold=medium --production",
    "validate": "npm run format:check && npm run lint && npm test",
    "publish": "npm run dist"
  },
  "license": "MIT",
  "keywords": [
    "joplin-plugin"
  ],
  "files": [
    "publish"
  ],
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^18.7.13",
    "@types/pdf-parse": "^1.1.5",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "chalk": "^4.1.0",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "fs-extra": "^10.1.0",
    "glob": "^11.1.0",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "prettier": "^3.8.1",
    "snyk": "^1.1303.2",
    "tar": "^7.5.13",
    "ts-jest": "^29.4.9",
    "ts-loader": "^9.3.1",
    "typescript": "^4.8.2",
    "webpack": "^5.74.0",
    "webpack-cli": "^4.10.0"
  },
  "overrides": {
    "tar": "^7.5.13",
    "glob": "^11.1.0",
    "markdown-it": "^14.1.1"
  },
  "dependencies": {
    "@joplin/utils": "3.5.1",
    "pdf-parse": "^2.4.5"
  }
}
